          <div class="mini-card-title">Indefinite-Life Intangibles</div>
          <ul>
            <li>Trademarks, Trade names</li>
            <li>Perpetual Franchises</li>
          </ul>
          <br>
          <div class="rule-box warn" style="margin:0;font-size:12px"><strong>DO NOT amortize.</strong></div>
