<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Accounting Study Guide — Ch. 9–11 & 16</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d0d0f;
    --surface: #141416;
    --surface2: #1c1c20;
    --border: #2a2a30;
    --accent: #e8c547;
    --accent2: #5b8cf5;
    --accent3: #e05a6b;
    --accent4: #4ecdc4;
    --text: #e8e8ec;
    --muted: #7a7a8a;
    --tag-bg: rgba(232,197,71,0.12);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 300;
    line-height: 1.7;
    min-height: 100vh;
  }

  /* HEADER */
  header {
    padding: 60px 40px 40px;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  header::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(232,197,71,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .header-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 60px);
    font-weight: 900;
    line-height: 1.1;
    color: #fff;
    max-width: 700px;
  }
  h1 span { color: var(--accent); }
  .header-sub {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  /* NAV TABS */
  .nav-bar {
    display: flex;
    gap: 0;
    padding: 0 40px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-bar::-webkit-scrollbar { display: none; }
  .tab-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 16px 22px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
    margin-bottom: -1px;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }

  /* MAIN CONTENT */
  main { padding: 40px; max-width: 1100px; }

  .chapter { display: none; animation: fadeUp 0.3s ease; }
  .chapter.active { display: block; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* SECTION CARDS */
  .section-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    margin-bottom: 28px;
    overflow: hidden;
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
    transition: background 0.15s;
  }
  .card-header:hover { background: var(--surface2); }
  .card-num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    background: var(--tag-bg);
    border: 1px solid rgba(232,197,71,0.25);
    padding: 3px 8px;
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    flex: 1;
  }
  .card-toggle {
    font-size: 18px;
    color: var(--muted);
    transition: transform 0.25s;
    flex-shrink: 0;
  }
  .card-toggle.open { transform: rotate(180deg); }
  .card-body {
    padding: 24px;
    display: none;
  }
  .card-body.open { display: block; }

  /* CONTENT ELEMENTS */
  h3 {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent2);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 22px 0 10px;
  }
  h3:first-child { margin-top: 0; }

  p, li { font-size: 14px; color: #c8c8d4; line-height: 1.75; }
  ul, ol { padding-left: 20px; }
  ul li, ol li { margin-bottom: 6px; }
  li::marker { color: var(--accent); }

  strong { color: var(--text); font-weight: 500; }
  em { color: var(--accent4); font-style: normal; font-weight: 500; }

  /* FORMULA BOX */
  .formula {
    background: #0a0a0c;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 2px;
    padding: 14px 18px;
    margin: 14px 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--accent);
    line-height: 1.8;
  }
  .formula .formula-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--muted);
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  /* JOURNAL ENTRY */
  .je {
    background: #0a0a0c;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent2);
    border-radius: 2px;
    padding: 14px 18px;
    margin: 14px 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    line-height: 2;
  }
  .je .je-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--muted);
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }
  .je-dr { color: var(--accent4); }
  .je-cr { color: var(--accent3); padding-left: 30px; display: block; }
  .je-dr { display: block; }

  /* RULE / ALERT */
  .rule-box {
    background: rgba(91,140,245,0.07);
    border: 1px solid rgba(91,140,245,0.25);
    border-radius: 2px;
    padding: 12px 16px;
    margin: 12px 0;
    font-size: 13px;
    color: #a8c0f8;
  }
  .rule-box.warn {
    background: rgba(224,90,107,0.07);
    border-color: rgba(224,90,107,0.25);
    color: #f0a0aa;
  }
  .rule-box.success {
    background: rgba(78,205,196,0.07);
    border-color: rgba(78,205,196,0.25);
    color: #8ee8e4;
  }
  .rule-box strong { color: inherit; }

  /* TABLE */
  .tbl-wrap { overflow-x: auto; margin: 14px 0; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  th {
    background: var(--surface2);
    color: var(--accent);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    color: #c0c0cc;
    vertical-align: top;
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(255,255,255,0.02); }

  /* STEP LIST */
  .steps { counter-reset: step; list-style: none; padding: 0; margin: 14px 0; }
  .steps li {
    counter-increment: step;
    display: flex;
    gap: 14px;
    margin-bottom: 14px;
    align-items: flex-start;
  }
  .steps li::before {
    content: counter(step);
    min-width: 26px; height: 26px;
    background: var(--accent);
    color: #000;
    border-radius: 50%;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .steps li p { margin: 0; }

  /* TAGS */
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
  .tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 2px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .tag.y { background: rgba(232,197,71,0.15); color: var(--accent); border: 1px solid rgba(232,197,71,0.3); }
  .tag.b { background: rgba(91,140,245,0.15); color: var(--accent2); border: 1px solid rgba(91,140,245,0.3); }
  .tag.r { background: rgba(224,90,107,0.15); color: var(--accent3); border: 1px solid rgba(224,90,107,0.3); }
  .tag.g { background: rgba(78,205,196,0.15); color: var(--accent4); border: 1px solid rgba(78,205,196,0.3); }

  /* QUIZ */
  .quiz-section { margin-top: 10px; }
  .quiz-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 20px 24px;
    margin-bottom: 18px;
  }
  .quiz-q {
    font-size: 14px;
    color: #fff;
    font-weight: 500;
    margin-bottom: 14px;
    line-height: 1.6;
  }
  .quiz-q span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    font-weight: 600;
    margin-right: 8px;
    letter-spacing: 0.1em;
  }
  .quiz-options { display: flex; flex-direction: column; gap: 8px; }
  .quiz-opt {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 10px 16px;
    font-size: 13px;
    color: #c0c0cc;
    cursor: pointer;
    transition: all 0.15s;
    text-align: left;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .quiz-opt:hover { border-color: var(--accent); color: var(--text); }
  .quiz-opt.correct { background: rgba(78,205,196,0.12); border-color: var(--accent4); color: var(--accent4); }
  .quiz-opt.wrong { background: rgba(224,90,107,0.12); border-color: var(--accent3); color: var(--accent3); }
  .quiz-explanation {
    margin-top: 12px;
    padding: 12px 16px;
    background: #0a0a0c;
    border-left: 3px solid var(--accent4);
    font-size: 13px;
    color: #a0a0b0;
    display: none;
  }
  .quiz-score {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .quiz-score span { color: var(--accent); font-weight: 600; }

  /* DIVIDER */
  hr { border: none; border-top: 1px solid var(--border); margin: 24px 0; }

  /* CHEAT SHEET GRID */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 14px 0; }
  @media (max-width: 700px) { .grid-2 { grid-template-columns: 1fr; } }
  .mini-card {
    background: #0a0a0c;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 16px;
  }
  .mini-card-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .mini-card p, .mini-card li { font-size: 13px; }
</style>
