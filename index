<script>
// ── TAB SWITCHING ──
function showTab(id) {
  document.querySelectorAll('.chapter').forEach(c => c.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  event.currentTarget.classList.add('active');
  if (id === 'quiz') buildQuiz();
}

// ── CARD TOGGLE ──
function toggleCard(header) {
  const body = header.nextElementSibling;
  const arrow = header.querySelector('.card-toggle');
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open', !isOpen);
  arrow.classList.toggle('open', !isOpen);
}

// ── QUIZ DATA ──
const questions = [
  {
    q: "Which of the following costs should NOT be capitalized as part of the cost of land?",
    opts: ["Attorney fees for title search", "Cost of demolishing an old building", "Proceeds from selling salvaged bricks", "Assumption of a prior mortgage"],
    ans: 2,
    exp: "Proceeds from selling salvaged materials are SUBTRACTED from the cost of land — they reduce the capitalized amount, not add to it."
  },
  {
    q: "When capitalizing interest on a self-constructed asset, what amount is capitalized?",
    opts: ["All actual interest incurred during construction", "All avoidable interest regardless of actual interest", "The lesser of avoidable interest or actual interest", "The greater of avoidable interest or actual interest"],
    ans: 2,
    exp: "GAAP requires capitalizing the LESSER of avoidable interest or actual interest incurred during the construction period."
  },
  {
    q: "Under DDB depreciation, which statement is CORRECT?",
    opts: ["Salvage value is subtracted from cost before applying the rate", "Depreciation stops when accumulated depreciation equals cost", "The rate is applied to beginning book value each period", "DDB produces equal depreciation expense each year"],
    ans: 2,
    exp: "DDB: rate = (2 ÷ life) × BEGINNING BOOK VALUE. Salvage value is NOT deducted from the base. Depreciation stops when BV = salvage value."
  },
  {
    q: "Company A exchanges equipment with no commercial substance. They receive a gain and also receive cash (boot). Cash is 15% of total transaction value. What happens to the gain?",
    opts: ["Recognize the entire gain immediately", "Defer the entire gain", "Recognize a partial gain using the boot formula", "Recognize a partial gain only if boot > 25%"],
    ans: 2,
    exp: "No commercial substance + cash received = partial gain recognized. Formula: Gain × [Cash ÷ (Cash + FV of Asset Received)]. The >25% threshold triggers FULL gain recognition, which doesn't apply here (15%)."
  },
  {
    q: "An internally developed patent's legal costs to successfully DEFEND it in court should be:",
    opts: ["Expensed immediately as R&D", "Capitalized as part of the patent's cost", "Recorded as a loss", "Amortized over 20 years immediately"],
    ans: 1,
    exp: "While internally created intangibles are generally expensed, an exception exists: direct costs to SECURE or DEFEND an intangible (like legal fees for a successful patent defense) are capitalized."
  },
  {
    q: "Research and development (R&D) equipment that has alternative future uses should be:",
    opts: ["Expensed entirely in the period purchased", "Capitalized and not depreciated", "Capitalized; depreciation classified as R&D expense", "Expensed as R&D over the asset's useful life"],
    ans: 2,
    exp: "Equipment with alternative future uses is the KEY exception to the 'expense R&D as incurred' rule. Capitalize it, then depreciate it — but classify the depreciation as R&D expense each period."
  },
  {
    q: "Under the Equity Method (20–50% ownership), how are dividends received from the investee recorded?",
    opts: ["Dr. Cash / Cr. Dividend Revenue", "Dr. Cash / Cr. Equity Investments", "Dr. Equity Investments / Cr. Investment Income", "No entry required"],
    ans: 1,
    exp: "Under the Equity Method, dividends are treated as a RETURN OF CAPITAL — they reduce the carrying amount of the investment (Cr. Equity Investments), not recognized as income."
  },
  {
    q: "For Available-for-Sale (AFS) debt securities, unrealized holding gains and losses are reported in:",
    opts: ["Net Income on the Income Statement", "Other Comprehensive Income (OCI) in Stockholders' Equity", "Retained Earnings directly", "Not reported until sold"],
    ans: 1,
    exp: "AFS unrealized G/L → OCI (a separate component of Stockholders' Equity). This is a key distinction from Trading securities, where unrealized G/L flows through Net Income."
  },
  {
    q: "Goodwill can be recorded on the balance sheet ONLY when:",
    opts: ["The company develops a strong internal brand", "An entire business is purchased at a premium", "The company has superior management talent", "The fair value of assets exceeds book value"],
    ans: 1,
    exp: "Goodwill is only recorded in a business combination (purchasing an entire business). It equals: Purchase Price − FMV of Net Identifiable Assets. Internally generated goodwill is NEVER recorded."
  },
  {
    q: "Asset impairment is indicated when book value exceeds:",
    opts: ["Fair value of the asset", "Replacement cost of the asset", "The sum of undiscounted expected future cash flows", "The present value of future cash flows"],
    ans: 2,
    exp: "Step 1 recoverability test: If BV > SUM OF UNDISCOUNTED future cash flows → impaired. Then Step 2 calculates the loss as BV − Fair Value. Note: the test uses UNDISCOUNTED cash flows, not present value."
  },
  {
    q: "A change in estimated useful life or salvage value of a depreciable asset is accounted for:",
    opts: ["Retrospectively — restate all prior periods", "Prospectively — adjust going forward only", "As a prior period error correction", "By recording a catch-up adjustment in the current year"],
    ans: 1,
    exp: "Changes in accounting ESTIMATES (like useful life or salvage value) are handled PROSPECTIVELY. No restatement of prior periods. Use: (Remaining BV − New SV) ÷ Remaining Life."
  },
  {
    q: "Which debt security category uses AMORTIZED COST for balance sheet valuation?",
    opts: ["Available-for-Sale", "Trading", "Held-to-Maturity", "All debt securities"],
    ans: 2,
    exp: "Only HTM (Held-to-Maturity) securities are carried at amortized cost. Both Trading and AFS securities are reported at Fair Value on the balance sheet."
  }
];

let answered = 0, correct = 0;
let quizBuilt = false;

function buildQuiz() {
  if (quizBuilt) return;
  quizBuilt = true;
  const container = document.getElementById('quiz-container');
  document.getElementById('total-display').textContent = questions.length;

  questions.forEach((q, qi) => {
    const card = document.createElement('div');
    card.className = 'quiz-card';
    card.innerHTML = `
      <div class="quiz-q"><span>Q${qi+1}</span>${q.q}</div>
      <div class="quiz-options">
        ${q.opts.map((o,oi) => `<button class="quiz-opt" onclick="answerQ(${qi},${oi},this)">${o}</button>`).join('')}
      </div>
      <div class="quiz-explanation" id="exp-${qi}">💡 ${q.exp}</div>
    `;
    container.appendChild(card);
  });
}

function answerQ(qi, chosen, btn) {
  const card = btn.closest('.quiz-card');
  if (card.dataset.answered) return;
  card.dataset.answered = 'true';
  answered++;

  const opts = card.querySelectorAll('.quiz-opt');
  opts.forEach(o => o.disabled = true);

  if (chosen === questions[qi].ans) {
    btn.classList.add('correct');
    correct++;
  } else {
    btn.classList.add('wrong');
    opts[questions[qi].ans].classList.add('correct');
  }

  document.getElementById(`exp-${qi}`).style.display = 'block';
  document.getElementById('score-display').textContent = correct;
  document.getElementById('total-display').textContent = answered + ' / ' + questions.length;
}
</script>
